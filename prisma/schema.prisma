// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SiteSettings {
  id              Int      @id @default(autoincrement())
  siteName        String   @default("Viajeros Radio")
  slogan          String   @default("Sencillito y de alpargatas")
  logoUrl         String   @default("/logo.jpg")
  faviconUrl      String   @default("/favicon.jpg")
  streamUrl       String   @default("https://streamingraddios.online/proxy/lavozdel?mp=/stream")
  metaTitle       String   @default("Viajeros Radio - Sencillito y de alpargatas")
  metaDescription String   @default("Radio uruguaya con identidad folclórica y rural")
  ogImage         String?
  contactName     String?
  contactEmail    String?
  whatsappNumber  String?
  whatsappMessage String   @default("Hola, Viajeros Radio. Me comunico desde la página web.")
  whatsappEnabled Boolean  @default(false)
  footerText      String   @default("© Viajeros Radio. Todos los derechos reservados.")
  updatedAt       DateTime @updatedAt
}

model SocialNetwork {
  id           Int     @id @default(autoincrement())
  platform     String
  url          String
  label        String
  visible      Boolean @default(true)
  displayOrder Int     @default(0)
}

model ContactInfo {
  id           Int     @id @default(autoincrement())
  name         String
  whatsapp     String?
  email        String?
  visible      Boolean @default(true)
  displayOrder Int     @default(0)
}

model MenuItem {
  id           Int     @id @default(autoincrement())
  slug         String  @unique
  label        String
  displayOrder Int     @default(0)
  visible      Boolean @default(true)
  icon         String?
}

model Program {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  conductor   String?
  socialLinks String?
  active      Boolean           @default(true)
  lunAViernes Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  schedules   ProgramSchedule[]
}

model ProgramSchedule {
  id        Int     @id @default(autoincrement())
  programId Int
  dayOfWeek Int
  startTime String
  endTime   String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model Event {
  id             Int          @id @default(autoincrement())
  title          String
  description    String?
  eventDate      DateTime
  eventTime      String?
  location       String?
  imageUrl       String?
  videoUrl       String?
  externalLink   String?
  additionalInfo String?
  status         String       @default("borrador")
  featured       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  images         EventImage[]
}

model EventImage {
  id           Int     @id @default(autoincrement())
  eventId      Int
  imageUrl     String
  caption      String?
  displayOrder Int     @default(0)
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Video {
  id           Int      @id @default(autoincrement())
  youtubeUrl   String
  title        String?
  description  String?
  thumbnailUrl String?
  videoType    String   @default("video")
  visible      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Album {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  coverImageUrl String?
  published     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  photos        Photo[]
}

model Photo {
  id           Int     @id @default(autoincrement())
  albumId      Int
  imageUrl     String
  thumbnailUrl String?
  caption      String?
  displayOrder Int     @default(0)
  album        Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model AboutSection {
  id           Int     @id @default(autoincrement())
  sectionKey   String  @unique
  title        String
  content      String?
  displayOrder Int     @default(0)
  visible      Boolean @default(true)
}

model TeamMember {
  id           Int     @id @default(autoincrement())
  name         String
  role         String?
  description  String?
  photoUrl     String?
  socialLinks  String?
  displayOrder Int     @default(0)
  visible      Boolean @default(true)
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id            String    @id
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("user")
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                       String    @id
  accountId                String
  providerId               String
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken              String?
  refreshToken             String?
  idToken                  String?
  accessTokenExpiresAt     DateTime?
  refreshTokenExpiresAt    DateTime?
  scope                    String?
  password                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}
